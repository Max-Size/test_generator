# Polza.ai — OpenAI-совместимый API (https://polza.ai/docs/glavnoe/quickstart)
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_API_KEY=
# Модель из каталога GET https://polza.ai/api/v1/models
POLZA_MODEL=openai/gpt-4o
# Контекстное окно POLZA_MODEL, в токенах. Обязательна — обновляй вручную вместе с POLZA_MODEL.
# Из неё считается max_context_chars (см. app/config.py).
POLZA_MODEL_CONTEXT_TOKENS=128000
# Строгий JSON по схеме. Выключить, если модель не поддерживает response_format=json_schema
POLZA_JSON_SCHEMA=true
# strict:true — жёсткая гарантия структуры; выключить, если модель не поддерживает
POLZA_JSON_SCHEMA_STRICT=true
POLZA_TEMPERATURE=0.4
POLZA_TIMEOUT=180
# Откуда фронт делает запросы (CORS)
CORS_ORIGINS=http://localhost:5173
# Ограничения
MAX_FILES=5
MAX_QUESTIONS=30
# Максимальный размер одного загружаемого файла, МБ
MAX_FILE_SIZE_MB=20
# Извлечение содержимого документов
# Кэш результатов извлечения (Markdown) по SHA-256 файла
INGEST_CACHE_DIR=.cache/ingest
# Домысливать «тяжёлые» страницы PDF (картинки, графики, формулы) через vision-модель
VISION_ENABLED=true
# Мультимодальная модель для распознавания страниц-картинок
VISION_MODEL=openai/gpt-4o
VISION_DPI=150
# Максимум страниц одного файла, отправляемых в vision-модель (ограничение затрат)
VISION_MAX_PAGES=20
# Сколько страниц распознаётся параллельно
VISION_CONCURRENCY=4
# Страницы с текстовым слоем короче этого считаем «тяжёлыми»
VISION_MIN_TEXT_CHARS=200
# Логирование: DEBUG показывает промпт и сырой ответ LLM
LOG_LEVEL=INFO
